# Bharmafills — Environment Configuration Template
# Copy this file to .env and fill in the values for development.
# WARNING: NEVER COMMIT ACTUAL SECRETS OR .env TO VERSION CONTROL.

# Environment Mode
ENVIRONMENT=development

# Backend API Configuration (Planned for Phase 4)
BACKEND_PORT=8000
BACKEND_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase Configuration (Step 6 & Phase C)
# Project URL and public anon key for client-side queries
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key-here
# Service role key (Backend only, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-backend-service-role-key-here
# Supabase PostgreSQL Session Pooler connection string (Backend only)
SUPABASE_DB_URL=postgresql://placeholder:placeholder@placeholder:5432/postgres

# Supabase Authentication & JWT Configuration (Phase C)
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256
# Optional separate HS256 secret for local/offline testing (leave empty to use asymmetric ES256/JWKS)
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_CACHE_TTL_SECONDS=3600.0
SUPABASE_JWKS_REFRESH_COOLDOWN_SECONDS=10.0

# Web Extraction & SSRF Defense Configuration (Step 7)
WEB_FETCH_MAX_RESPONSE_BYTES=2097152
WEB_FETCH_MAX_REDIRECTS=5
WEB_FETCH_TIMEOUT_CONNECT_SECONDS=5.0
WEB_FETCH_TIMEOUT_READ_SECONDS=10.0

# PDF Extraction Configuration (Step 8)
PDF_MAX_UPLOAD_BYTES=20971520
PDF_MAX_PAGES=200
PDF_EXTRACTION_TIMEOUT_SECONDS=30.0

# AI Provider Configuration — OpenRouter API (Step 9A)
# Active Model: NVIDIA Nemotron 3 Ultra (runtime-configurable)
# PRIVACY NOTICE: Free-tier model endpoint. Never transmit confidential or personally identifiable data.
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30.0

# Future AI Provider Configuration (Alternative / Planned)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Bharmafills — Environment Configuration Template
# Copy this file to .env and fill in the values for development.
# WARNING: NEVER COMMIT ACTUAL SECRETS OR .env TO VERSION CONTROL.

# Environment Mode
ENVIRONMENT=development

# Backend API Configuration (Planned for Phase 4)
BACKEND_PORT=8000
BACKEND_HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase Configuration (Planned for Phase 4)
# Project URL and public anon key for client-side queries
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key-here
# Service role key (Backend only, never expose to frontend)
SUPABASE_SERVICE_ROLE_KEY=your-backend-service-role-key-here

# Google Gemini API Configuration (Planned for Step 9)
# Model is runtime-configurable; choice verified based on availability, latency, cost, and structured JSON output.
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

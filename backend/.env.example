# Bharmafills Backend — Local Environment Variables Example
# Copy to backend/.env and configure with your Supabase credentials.
# NEVER COMMIT backend/.env TO VERSION CONTROL.

ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase PostgreSQL Session Pooler Connection String (Backend only)
# Format: postgresql://[user]:[password]@[host]:5432/[database]
SUPABASE_DB_URL=postgresql://placeholder:placeholder@placeholder:5432/postgres

# Supabase Authentication & JWT Configuration (Phase C)
# Base project URL (optional if derived from SUPABASE_DB_URL)
SUPABASE_URL=https://your-project-ref.supabase.co
# JWKS public key endpoint (defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json)
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256
# Optional separate HS256 secret for local offline development / tests
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_CACHE_TTL_SECONDS=3600.0
SUPABASE_JWKS_REFRESH_COOLDOWN_SECONDS=10.0

# Web Extraction & SSRF Defense Configuration (Step 7)
WEB_FETCH_MAX_RESPONSE_BYTES=2097152
WEB_FETCH_MAX_REDIRECTS=5
WEB_FETCH_TIMEOUT_CONNECT_SECONDS=5.0
WEB_FETCH_TIMEOUT_READ_SECONDS=10.0

# PDF Extraction Configuration (Step 8)
PDF_MAX_UPLOAD_BYTES=20971520
PDF_MAX_PAGES=200
PDF_EXTRACTION_TIMEOUT_SECONDS=30.0

# AI Provider Configuration — OpenRouter API (Step 9A)
# Active Model: NVIDIA Nemotron 3 Ultra (runtime-configurable)
# PRIVACY NOTICE: Free-tier model endpoint. Never transmit confidential or personally identifiable data.
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=30.0

